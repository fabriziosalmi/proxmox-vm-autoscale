[Unit]
Description=Proxmox VM Autoscale Service
Documentation=https://github.com/fabriziosalmi/proxmox-vm-autoscale
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/vm_autoscale/autoscale.py
WorkingDirectory=/usr/local/bin/vm_autoscale
Restart=always
RestartSec=10
User=root
Environment=PYTHONUNBUFFERED=1

# The service handles SIGTERM: it finishes the VM it is on, stops the metrics
# endpoint and leaves the billing state file intact. Give it room to do that
# rather than SIGKILLing it mid-write.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
